#!/bin/sh

# Post-install script for os-proxygateway

# Create runtime directories
mkdir -p -m 0750 /var/run/proxygateway
mkdir -p /var/log/proxygateway

# Set script permissions
chmod +x /usr/local/opnsense/scripts/OPNsense/ProxyGateway/*.sh
chmod +x /usr/local/opnsense/scripts/OPNsense/ProxyGateway/*.py
chmod +x /usr/local/etc/rc.d/opnsense-proxygateway
# Logging library is sourced, not executed, but keep consistent
chmod +r /usr/local/opnsense/scripts/OPNsense/ProxyGateway/lib/*.sh

# Enable the service
sysrc proxygateway_enable=YES 2>/dev/null || true

# Register interface group
/usr/local/sbin/configctl interface invoke registration 2>/dev/null || true

# Reload configd to pick up new actions
/usr/local/sbin/configctl configd actions 2>/dev/null || true

echo "os-proxygateway installed successfully."
echo ""
echo "Next steps:"
echo "  1. Install the tun2socks binary (SHA256-verified):"
echo "     make install-tun2socks   (from the os-proxygateway source tree)"
echo "  2. Go to Services → Proxy Gateway to configure connections"
echo "  3. Enable the service and add your first proxy connection"
