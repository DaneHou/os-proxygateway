<model>
    <mount>//OPNsense/ProxyGateway</mount>
    <version>0.4.0</version>
    <description>Multi-Proxy Gateway Configuration</description>

    <items>
        <!-- Global settings -->
        <general>
            <enabled type="BooleanField">
                <default>0</default>
                <Required>Y</Required>
            </enabled>
            <startOnBoot type="BooleanField">
                <default>1</default>
                <Required>Y</Required>
            </startOnBoot>
            <watchdogEnabled type="BooleanField">
                <default>1</default>
                <Required>Y</Required>
            </watchdogEnabled>
            <logLevel type="OptionField">
                <default>warn</default>
                <OptionValues>
                    <debug>Debug</debug>
                    <info>Info</info>
                    <warn>Warning</warn>
                    <error>Error</error>
                </OptionValues>
            </logLevel>
            <speedTestEnabled type="BooleanField">
                <default>0</default>
                <Required>Y</Required>
            </speedTestEnabled>
            <speedTestInterval type="OptionField">
                <default>m15</default>
                <OptionValues>
                    <m5>5 minutes</m5>
                    <m15>15 minutes</m15>
                    <m30>30 minutes</m30>
                    <m60>60 minutes</m60>
                </OptionValues>
            </speedTestInterval>
            <speedTestSize type="OptionField">
                <default>s10m</default>
                <OptionValues>
                    <s1m>1 MB (~1 MB download)</s1m>
                    <s5m>5 MB</s5m>
                    <s10m>10 MB (default)</s10m>
                    <s25m>25 MB</s25m>
                </OptionValues>
            </speedTestSize>
            <autoForceDown type="BooleanField">
                <default>1</default>
                <Required>Y</Required>
            </autoForceDown>
        </general>

        <!-- Proxy connections (multiple) -->
        <connections>
            <connection type="ArrayField">
                <enabled type="BooleanField">
                    <default>1</default>
                    <Required>Y</Required>
                </enabled>

                <name type="TextField">
                    <Required>Y</Required>
                    <Mask>/^[a-zA-Z0-9_]{1,16}$/</Mask>
                    <ValidationMessage>Name must be 1-16 alphanumeric characters or underscores</ValidationMessage>
                </name>

                <description type="TextField">
                    <Required>N</Required>
                    <Mask>/^[a-zA-Z0-9 _\-\.]{0,64}$/</Mask>
                    <ValidationMessage>Description: max 64 chars, alphanumeric with spaces, hyphens, underscores, dots</ValidationMessage>
                </description>

                <!-- Upstream proxy settings -->
                <proxyInterface type="InterfaceField">
                    <Required>N</Required>
                    <default>wan</default>
                    <filters>
                        <enable>/^1$/</enable>
                    </filters>
                    <ValidationMessage>Select the interface through which the proxy server is reachable</ValidationMessage>
                </proxyInterface>

                <proxyType type="OptionField">
                    <default>socks5</default>
                    <Required>Y</Required>
                    <OptionValues>
                        <socks5>SOCKS5</socks5>
                        <socks5tls>SOCKS5 + TLS</socks5tls>
                        <http>HTTP CONNECT</http>
                        <https>HTTPS CONNECT</https>
                        <ss>Shadowsocks</ss>
                        <ssh>SSH</ssh>
                    </OptionValues>
                </proxyType>

                <proxyServer type="TextField">
                    <Required>Y</Required>
                    <Mask>/^([a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?\.)*[a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?$|^([0-9]{1,3}\.){3}[0-9]{1,3}$|^\[([0-9a-fA-F]{0,4}:){2,7}[0-9a-fA-F]{0,4}\]$/</Mask>
                    <ValidationMessage>Enter a valid hostname or IP address (IPv4/IPv6)</ValidationMessage>
                </proxyServer>

                <proxyPort type="IntegerField">
                    <Required>Y</Required>
                    <default>1080</default>
                    <MinimumValue>1</MinimumValue>
                    <MaximumValue>65535</MaximumValue>
                </proxyPort>

                <authEnabled type="BooleanField">
                    <default>0</default>
                </authEnabled>

                <authUser type="TextField">
                    <Required>N</Required>
                    <Mask>/^[a-zA-Z0-9@._\-]{1,64}$/</Mask>
                    <ValidationMessage>Username must be 1-64 characters (alphanumeric, @, ., _, -)</ValidationMessage>
                </authUser>

                <authPass type="TextField">
                    <Required>N</Required>
                    <Mask>/^[\x20-\x7E]{1,128}$/</Mask>
                    <ValidationMessage>Password must be 1-128 printable ASCII characters</ValidationMessage>
                </authPass>

                <!-- Shadowsocks settings -->
                <ssMethod type="OptionField">
                    <default>aes-256-gcm</default>
                    <Required>N</Required>
                    <OptionValues>
                        <aes-128-gcm>AES-128-GCM</aes-128-gcm>
                        <aes-256-gcm>AES-256-GCM</aes-256-gcm>
                        <chacha20-ietf-poly1305>ChaCha20-IETF-Poly1305</chacha20-ietf-poly1305>
                        <xchacha20-ietf-poly1305>XChaCha20-IETF-Poly1305</xchacha20-ietf-poly1305>
                    </OptionValues>
                </ssMethod>
                <ssPassword type="TextField">
                    <Required>N</Required>
                    <Mask>/^[\x20-\x7E]{0,128}$/</Mask>
                    <ValidationMessage>Shadowsocks password: 0-128 printable ASCII characters</ValidationMessage>
                </ssPassword>
                <ssObfs type="OptionField">
                    <default></default>
                    <Required>N</Required>
                    <BlankDesc>None</BlankDesc>
                    <OptionValues>
                        <http>HTTP (obfs-http)</http>
                        <tls>TLS (obfs-tls)</tls>
                    </OptionValues>
                </ssObfs>
                <ssObfsHost type="TextField">
                    <Required>N</Required>
                    <Mask>/^([a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?\.)*[a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?$|^$/</Mask>
                    <ValidationMessage>Enter a valid hostname for obfuscation</ValidationMessage>
                </ssObfsHost>

                <!-- SSH settings -->
                <sshKeyFile type="TextField">
                    <Required>N</Required>
                    <Mask>/^[\/a-zA-Z0-9._\-]{0,256}$/</Mask>
                    <ValidationMessage>Enter a valid file path for the SSH private key</ValidationMessage>
                </sshKeyFile>

                <!-- Local tunnel settings -->
                <tunAddress type="TextField">
                    <Required>N</Required>
                    <Mask>/^([0-9]{1,3}\.){3}[0-9]{1,3}$/</Mask>
                    <ValidationMessage>Enter a valid IPv4 address (leave empty for auto-assign)</ValidationMessage>
                </tunAddress>

                <tunMTU type="IntegerField">
                    <default>1500</default>
                    <MinimumValue>1280</MinimumValue>
                    <MaximumValue>9000</MaximumValue>
                </tunMTU>

                <!-- Health check -->
                <healthCheckEnabled type="BooleanField">
                    <default>1</default>
                </healthCheckEnabled>

                <healthCheckTarget type="TextField">
                    <default></default>
                    <Required>N</Required>
                    <Mask>/^(https?:\/\/[^\s]{1,256})?$/</Mask>
                    <ValidationMessage>Enter a valid HTTP or HTTPS URL for health checks</ValidationMessage>
                </healthCheckTarget>

                <!-- Gateway settings -->
                <gatewayPriority type="IntegerField">
                    <default>255</default>
                    <MinimumValue>1</MinimumValue>
                    <MaximumValue>255</MaximumValue>
                </gatewayPriority>

                <!-- Speed test -->
                <speedTestUrl type="TextField">
                    <Required>N</Required>
                    <Mask>/^(https?:\/\/[^\s]{1,256})?$/</Mask>
                    <ValidationMessage>Enter a valid HTTP or HTTPS URL for speed testing</ValidationMessage>
                </speedTestUrl>
                <speedTestUrlDomestic type="TextField">
                    <Required>N</Required>
                    <Mask>/^(https?:\/\/[^\s]{1,256})?$/</Mask>
                    <ValidationMessage>Enter a valid HTTP or HTTPS URL for domestic speed testing</ValidationMessage>
                </speedTestUrlDomestic>

                <!-- Backup proxy for failover -->
                <backupEnabled type="BooleanField">
                    <default>0</default>
                </backupEnabled>
                <backupProxyType type="OptionField">
                    <default>socks5</default>
                    <Required>N</Required>
                    <OptionValues>
                        <socks5>SOCKS5</socks5>
                        <socks5tls>SOCKS5 + TLS</socks5tls>
                        <http>HTTP CONNECT</http>
                        <https>HTTPS CONNECT</https>
                        <ss>Shadowsocks</ss>
                        <ssh>SSH</ssh>
                    </OptionValues>
                </backupProxyType>
                <backupProxyServer type="TextField">
                    <Required>N</Required>
                    <Mask>/^([a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?\.)*[a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?$|^([0-9]{1,3}\.){3}[0-9]{1,3}$|^\[([0-9a-fA-F]{0,4}:){2,7}[0-9a-fA-F]{0,4}\]$|^$/</Mask>
                    <ValidationMessage>Enter a valid hostname or IP address for the backup proxy</ValidationMessage>
                </backupProxyServer>
                <backupProxyPort type="IntegerField">
                    <Required>N</Required>
                    <default>1080</default>
                    <MinimumValue>1</MinimumValue>
                    <MaximumValue>65535</MaximumValue>
                </backupProxyPort>
                <backupAuthEnabled type="BooleanField">
                    <default>0</default>
                </backupAuthEnabled>
                <backupAuthUser type="TextField">
                    <Required>N</Required>
                    <Mask>/^[a-zA-Z0-9@._\-]{0,64}$/</Mask>
                    <ValidationMessage>Username must be 0-64 characters (alphanumeric, @, ., _, -)</ValidationMessage>
                </backupAuthUser>
                <backupAuthPass type="TextField">
                    <Required>N</Required>
                    <Mask>/^[\x20-\x7E]{0,128}$/</Mask>
                    <ValidationMessage>Password must be 0-128 printable ASCII characters</ValidationMessage>
                </backupAuthPass>
                <backupSsMethod type="OptionField">
                    <default>aes-256-gcm</default>
                    <Required>N</Required>
                    <OptionValues>
                        <aes-128-gcm>AES-128-GCM</aes-128-gcm>
                        <aes-256-gcm>AES-256-GCM</aes-256-gcm>
                        <chacha20-ietf-poly1305>ChaCha20-IETF-Poly1305</chacha20-ietf-poly1305>
                        <xchacha20-ietf-poly1305>XChaCha20-IETF-Poly1305</xchacha20-ietf-poly1305>
                    </OptionValues>
                </backupSsMethod>
                <backupSsPassword type="TextField">
                    <Required>N</Required>
                    <Mask>/^[\x20-\x7E]{0,128}$/</Mask>
                    <ValidationMessage>Backup Shadowsocks password: 0-128 printable ASCII characters</ValidationMessage>
                </backupSsPassword>
                <backupSshKeyFile type="TextField">
                    <Required>N</Required>
                    <Mask>/^[\/a-zA-Z0-9._\-]{0,256}$/</Mask>
                    <ValidationMessage>Enter a valid file path for the backup SSH private key</ValidationMessage>
                </backupSshKeyFile>
                <failoverThreshold type="IntegerField">
                    <default>3</default>
                    <MinimumValue>1</MinimumValue>
                    <MaximumValue>10</MaximumValue>
                </failoverThreshold>
                <failbackEnabled type="BooleanField">
                    <default>1</default>
                </failbackEnabled>
            </connection>
        </connections>
    </items>
</model>
